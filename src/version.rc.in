#include <winver.h>
1 VERSIONINFO
FILEVERSION @DTS_FIXED_VERSION@
PRODUCTVERSION @DTS_FIXED_VERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Sonic853\0"
      VALUE "FileDescription", "TTPlayer DTS audio add-in\0"
      VALUE "FileVersion", "@DTS_BUILD_VERSION@\0"
      VALUE "InternalName", "ttp_dts\0"
      VALUE "OriginalFilename", "ttp_dts.dll\0"
      VALUE "ProductName", "TTPlayer Rebuild DTS\0"
      VALUE "ProductVersion", "@DTS_BUILD_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END


